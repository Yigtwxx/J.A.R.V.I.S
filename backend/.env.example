# ===========================================
#  J.A.R.V.I.S - Environment Configuration
#  Copy this file to .env and fill in values
# ===========================================

# Database Configuration
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./data/jarvis.db
# PostgreSQL (optional, for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/jarvis

# Ollama Configuration (Local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Multimodal model for image and screen reading.
# Must be an architecture the installed Ollama supports — llama3.2-vision
# (mllama) no longer loads on Ollama 0.32+.
VISION_MODEL=qwen2.5vl:7b

# GitHub API (Optional — increases rate limit from 60 to 5000 req/hr)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Restart the backend by itself whenever a source file changes. Off by
# default because a reload kills any search that is mid-flight, taking its
# browser pool and pending questions with it. Worth switching on while
# developing: without it a code change is invisible until you restart, and
# the symptom is a fix that looks like it did not work.
UVICORN_RELOAD=false

# Security — API Key Authentication
# Set a secret key to require X-API-Key header on search endpoints.
# Leave empty to disable authentication (default).
API_KEY=

# Rate Limiting (per IP address)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60


# Computer Control (System Control panel: CMD / APP / URL actions)
# Disabled by default. When true, the panel can queue shell commands
# (whitelist-restricted), app launches and URL opens — each one still
# requires explicit approval in the UI before it executes.
ENABLE_COMPUTER_CONTROL=false


# ===========================================
#  Discovery pipeline (app/discovery)
# ===========================================
# Every value below is the code default — the block is here so the settings are
# discoverable, not because they must be set.

# Master switch. With this off the search returns no social accounts at all.
DISCOVERY_ENABLED=true

# Browser tier (Scrapling + patchright-driven Chromium). Off degrades discovery
# to the plain HTTP tier: hard platforms report `blocked` instead of crashing.
# Requires `scrapling install` once, which start-jarvis.sh/.bat already run.
DISCOVERY_STEALTH_ENABLED=true
DISCOVERY_MAX_STEALTH_PAGES=3
DISCOVERY_MAX_CONCURRENT_STEALTH_SESSIONS=2

# Hard ceiling for one search. Time spent waiting on a question does not count
# against it: the budget bounds our work, not how long a human takes to answer.
DISCOVERY_MAX_WALL_CLOCK_SECONDS=1800

# Human-in-the-loop. A question has no deadline; this caps how many times one
# run may interrupt the user.
DISCOVERY_MAX_QUESTIONS=6

# -------------------------------------------
#  Anti-blocking
# -------------------------------------------
# Spread each rate-limit wait by +/- this fraction. Exactly periodic requests
# are a bot signal on their own; 0 restores machine-perfect pacing.
DISCOVERY_RATE_JITTER=0.3

# On a refusal with no Retry-After, widen that domain's interval for the rest of
# the process rather than knocking at the cadence that was just rejected.
DISCOVERY_ADAPTIVE_BACKOFF=true

# Keep cookies across requests and hand the ones the browser earned (Cloudflare
# clearance, consent) down to the cheap HTTP tier, so a challenge is solved once.
DISCOVERY_COOKIE_PERSISTENCE=true

# Reuse browser profile directories between searches so clearance and consent
# survive. Relative paths resolve against backend/; the directory is gitignored.
DISCOVERY_BROWSER_PROFILE_PERSIST=true
DISCOVERY_BROWSER_PROFILE_DIR=data/browser_profiles

# Launch the real installed Chrome instead of bundled Chromium when present.
# Ignored where no Chrome exists (the Docker image) — it falls back once.
DISCOVERY_REAL_CHROME=true

# Canvas noise is re-randomised per request, which contradicts the stable
# fingerprint a persisted profile exists to provide. Flip to compare.
DISCOVERY_HIDE_CANVAS=false

# -------------------------------------------
#  Optional outbound proxy
# -------------------------------------------
# The one lever that actually raises the per-IP ceiling. Empty = connect
# directly. Credentials are read from the environment only and masked in logs.
# DISCOVERY_PROXY_URL=http://user:pass@host:8080
# DISCOVERY_PROXY_POOL=["http://host1:8080","http://host2:8080"]
# DISCOVERY_PROXY_PLATFORMS=["instagram","tiktok","linkedin"]

# --- Interactive browse tier -------------------------------------------------
# Last-resort tier: drives a real (headless) page - scroll, click, read - when
# both the HTTP and stealth tiers were refused or came back empty. Costs one
# local vision inference per step, so the budgets are deliberately tight.
DISCOVERY_BROWSE_ENABLED=true
DISCOVERY_BROWSE_MAX_TASKS_PER_SEARCH=2
DISCOVERY_BROWSE_MAX_STEPS=12
DISCOVERY_BROWSE_MAX_SECONDS=180
DISCOVERY_BROWSE_MIN_TIME_LEFT_SECONDS=300

# Empty falls back to VISION_MODEL.
DISCOVERY_BROWSE_MODEL=

# Pixel clicking is the fallback for targets with no DOM node (canvas, maps).
DISCOVERY_BROWSE_ALLOW_PIXEL_CLICKS=true

# Screenshots shown live in the console. Swept on TTL and on session teardown.
DISCOVERY_BROWSE_FRAME_DIR=data/browse_frames
DISCOVERY_BROWSE_FRAME_TTL_SECONDS=3600
DISCOVERY_BROWSE_FRAME_MAX_FILES=500

# --- Logging -----------------------------------------------------------------
# The console output and the live-status SSE feed are always on. This switch
# only controls the *file* mirror (backend/logs/jarvis.log). It is off by
# default because the directory regenerated itself after every clean-up; turn it
# on for a run you want to inspect afterwards, or use `start-jarvis --logs`,
# which sets this and captures the two server stdout files as well.
JARVIS_FILE_LOGGING=false
