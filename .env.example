# Root-level env consumed by docker-compose.yml only.
# Copy to .env (gitignored) and fill in. Backend runtime secrets stay in backend/.env.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle by `next build`,
# so they are public by design — never put a real secret here.

# Where the browser (running on the host) reaches the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match API_KEY in backend/.env, otherwise every request returns 401.
NEXT_PUBLIC_API_KEY=
