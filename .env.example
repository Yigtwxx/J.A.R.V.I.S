# Root-level env consumed by docker-compose.yml only.
# Copy to .env (gitignored) and fill in. Backend runtime secrets stay in backend/.env.
#
# Nothing here reaches the browser. The console calls its own origin and
# frontend/app/api/proxy relays to the backend server-side, so the key below is
# read by the Next.js server at runtime and is never compiled into the bundle.

# Where the Next.js server reaches the backend. Under docker-compose this is
# overridden to http://backend:8000, the address on the compose network.
BACKEND_URL=http://localhost:8000

# Must match API_KEY in backend/.env, otherwise every request returns 401.
API_KEY=
